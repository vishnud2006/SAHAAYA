# SAHAAYA Environment Configuration

# 1. Google Gemini AI Engine (Required for live Gemini analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google OAuth 2.0 Credentials (Required for production Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 3. Application URL (Optional: auto-detected from request host if omitted)
# For local development: http://localhost:3000
# For production: https://sahaaya.vercel.app
APP_URL=http://localhost:3000

# 4. Session Secret (Optional: default secure secret provided)
SAHAAYA_SESSION_SECRET=your_custom_session_signing_secret_here

# 5. Persistent PostgreSQL Database (Required for Production / Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
